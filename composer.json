{
    "name": "atwx/silverstripe-typesense-prefix",
    "description": "Collection prefix per installation for elliotsawyer/silverstripe-typesense, so live, staging and test can share one Typesense server",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "typesense", "search", "staging"],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "elliotsawyer/silverstripe-typesense": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\TypesensePrefix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\TypesensePrefix\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
